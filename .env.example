# ─────────────────────────────────────────────
# Redis
# Deve apontar para o Redis do projeto-driver.
# Em produção com Docker Compose: redis://redis:6379
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Brevo — provedor de e-mail (obrigatório)
# 1. Crie conta em brevo.com
# 2. Verifique seu e-mail remetente em Settings → Senders & IPs → Senders
# 3. Gere a API Key em Settings → API Keys
# ─────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
BREVO_FROM=seuapp@gmail.com
BREVO_FROM_NAME=Driver App

# ─────────────────────────────────────────────
# Links (para construir URLs nos e-mails)
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ─────────────────────────────────────────────
# HTTP + WebSocket
# ADMIN_API_KEY é usada em três lugares:
#   - Header X-Admin-Key no POST /admin/message
#   - Senha do Basic Auth no Bull Board (/admin/queues)
#   - Query param ?token= nas conexões WebSocket
# ─────────────────────────────────────────────
PORT=3002
ADMIN_API_KEY=troque-por-chave-segura-gerada-com-openssl

# ─────────────────────────────────────────────
# Bull Board — restrição de IP (opcional)
# Lista de IPs separados por vírgula que podem acessar /admin/queues.
# Se vazio, qualquer IP com credenciais válidas pode acessar.
# ─────────────────────────────────────────────
BULL_BOARD_ALLOWED_IPS=

# ─────────────────────────────────────────────
# Watchtower — autenticação no GHCR (GitHub Container Registry)
# Necessário para o Watchtower puxar imagens privadas automaticamente.
# Gere um token em github.com → Settings → Developer settings →
# Personal access tokens → read:packages
# ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ─────────────────────────────────────────────
# Heartbeat WebSocket (opcional)
# ─────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL_MS=30000
